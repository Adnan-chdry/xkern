#pragma once
/* Freestanding <utility> -- move, forward, swap, declval, integer sequences */

#include <cstddef>
#include "type_traits"

namespace std {

/* ---- move / forward ---- */

template <typename T>
constexpr typename remove_reference<T>::type &&move(T &&t) noexcept
{
    return static_cast<typename remove_reference<T>::type &&>(t);
}

template <typename T>
constexpr T &&forward(typename remove_reference<T>::type &t) noexcept
{
    return static_cast<T &&>(t);
}

template <typename T>
constexpr T &&forward(typename remove_reference<T>::type &&t) noexcept
{
    return static_cast<T &&>(t);
}

/* ---- swap ---- */

template <typename T>
constexpr void swap(T &a, T &b) noexcept
{
    T tmp = static_cast<T &&>(a);
    a = static_cast<T &&>(b);
    b = static_cast<T &&>(tmp);
}

template <typename T, size_t N>
constexpr void swap(T (&a)[N], T (&b)[N]) noexcept
{
    for (size_t i = 0; i < N; i++) {
        T tmp = static_cast<T &&>(a[i]);
        a[i] = static_cast<T &&>(b[i]);
        b[i] = static_cast<T &&>(tmp);
    }
}

/* ---- pair ---- */

template <typename T1, typename T2>
struct pair {
    T1 first;
    T2 second;

    constexpr pair() : first(), second() {}
    constexpr pair(const T1 &a, const T2 &b) : first(a), second(b) {}
    constexpr pair(T1 &&a, T2 &&b)
        : first(static_cast<T1 &&>(a)), second(static_cast<T2 &&>(b)) {}

    template <typename U1, typename U2>
    constexpr pair(const pair<U1, U2> &o) : first(o.first), second(o.second) {}
};

template <typename T1, typename T2>
constexpr pair<T1, T2> make_pair(T1 &&a, T2 &&b)
{
    return pair<T1, T2>(static_cast<T1 &&>(a), static_cast<T2 &&>(b));
}

/* ---- declval ---- */

template <typename T>
typename add_rvalue_reference<T>::type declval() noexcept;

/* ---- integer_sequence ---- */

template <typename T, T... Ints>
struct integer_sequence {
    using value_type = T;
    static constexpr size_t size() { return sizeof...(Ints); }
};

template <size_t... Ints>
using index_sequence = integer_sequence<size_t, Ints...>;

namespace detail {

template <size_t N, size_t... Is>
struct make_index_seq_impl : make_index_seq_impl<N - 1, N - 1, Is...> {};

template <size_t... Is>
struct make_index_seq_impl<0, Is...> {
    using type = index_sequence<Is...>;
};

} // namespace detail

template <size_t N>
using make_index_sequence = typename detail::make_index_seq_impl<N>::type;

template <typename T, T N>
struct make_integer_sequence;

template <size_t N>
using index_sequence_for = make_index_sequence<N>;

} // namespace std
